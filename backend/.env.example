# ArthSetu Backend Configuration
PROJECT_NAME="ArthSetu API"
API_V1_STR="/api"
SECRET_KEY="arthsetu-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite for local dev, easily swappable to PostgreSQL)
DATABASE_URL="sqlite:///./arthsetu.db"

# CORS Configuration (comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# AI Assistant Configuration
# Supported providers: "gemini" (default), "openai", "mock"
AI_PROVIDER="gemini"

# Google Gemini API Key (e.g., from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=""

# OpenAI API Key (optional alternative: https://platform.openai.com/)
OPENAI_API_KEY=""

# Configurable AI Model identifier
# For Gemini: e.g. "gemini-3.6-flash", "gemini-2.5-flash"
# For OpenAI: e.g. "gpt-4o-mini", "gpt-4o"
AI_MODEL="gemini-3.6-flash"

# WhatsApp / Twilio Webhook Configuration
# NOTE: For real WhatsApp delivery during development, Twilio requires a publicly
# accessible HTTPS webhook URL (e.g., using ngrok: 'ngrok http 8000' -> https://xxxx.ngrok.app/api/whatsapp/webhook).
# Localhost alone cannot receive inbound webhooks from Twilio's cloud servers.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
TWILIO_VALIDATE_SIGNATURE=False

